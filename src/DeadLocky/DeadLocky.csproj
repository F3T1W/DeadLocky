<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0-macos;net10.0</TargetFrameworks>
    <DefaultItemExcludes>$(DefaultItemExcludes);bin/**;obj/**</DefaultItemExcludes>
  </PropertyGroup>
  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0-macos'">
    <OutputType>Exe</OutputType>
    <RuntimeIdentifier>osx-arm64</RuntimeIdentifier>
    <SupportedOSPlatformVersion>14.0</SupportedOSPlatformVersion>
    <PublishAot Condition="'$(Configuration)' == 'Release'">true</PublishAot>
    <NoDSymUtil Condition="'$(PublishAot)' == 'true'">true</NoDSymUtil>
    <ApplicationId>org.milkdeadlockdry.launcher</ApplicationId>
  </PropertyGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-macos'">
    <BundleResource Include="../../docs/ThirdPartyNotices.txt" LogicalName="ThirdPartyNotices.txt"/>
    <BundleResource Include="../../LICENSE" LogicalName="LICENSE"/>
    <BundleResource Include="App/Assets/AppIcon.icns" LogicalName="AppIcon.icns"/>
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <Compile Remove="App/**/*.cs;Pages/**/*.cs;Features/*/Ui/**/*.cs;Shared/Ui/**/*.cs"/>
    <Compile Remove="Shared/Api/Directories/AppKitDirectoryPicker.cs"/>
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Features/UpdateApp/Api/InstallUpdate.sh" LogicalName="DeadLocky.InstallUpdate.sh"/>
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="DeadLocky.UnitTests"/>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="SharpCompress" Version="0.50.5"/>
    <PackageReference Include="ValveResourceFormat" Version="20.1.7467"/>
  </ItemGroup>
</Project>
